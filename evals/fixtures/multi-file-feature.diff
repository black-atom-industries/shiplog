new file mode 100644
--- /dev/null
+++ b/src/export/csv.ts
@@ -0,0 +1,15 @@
+export interface Contact {
+    name: string;
+    email: string;
+}
+
+function cell(value: string): string {
+    return /[",\r\n]/.test(value) ? `"${value.replaceAll('"', '""')}"` : value;
+}
+
+export function contactsCsv(contacts: Contact[]): string {
+    return [
+        "name,email",
+        ...contacts.map(({ name, email }) => `${cell(name)},${cell(email)}`),
+    ].join("\r\n") + "\r\n";
+}
diff --git a/src/commands/export.ts b/src/commands/export.ts
new file mode 100644
--- /dev/null
+++ b/src/commands/export.ts
@@ -0,0 +1,7 @@
+import { contactsCsv } from "../export/csv.ts";
+import { loadContacts } from "../storage.ts";
+
+export async function exportContacts(path: string): Promise<void> {
+    const contacts = await loadContacts();
+    await Deno.writeTextFile(path, contactsCsv(contacts), { createNew: true });
+}
