diff --git a/src/export/csv_test.ts b/src/export/csv_test.ts
new file mode 100644
--- /dev/null
+++ b/src/export/csv_test.ts
@@ -0,0 +1,20 @@
+import { assertEquals } from "@std/assert";
+import { contactsCsv } from "./csv.ts";
+
+Deno.test("CSV includes a header even without contacts", () => {
+    assertEquals(contactsCsv([]), "name,email\r\n");
+});
+
+Deno.test("CSV escapes commas and quotes", () => {
+    assertEquals(
+        contactsCsv([{ name: 'Lee, "Jo"', email: "jo@example.test" }]),
+        'name,email\r\n"Lee, ""Jo""",jo@example.test\r\n',
+    );
+});
+
+Deno.test("CSV quotes embedded line breaks", () => {
+    assertEquals(
+        contactsCsv([{ name: "Jo\nLee", email: "jo@example.test" }]),
+        'name,email\r\n"Jo\nLee",jo@example.test\r\n',
+    );
+});
