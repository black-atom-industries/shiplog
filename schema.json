{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "provider": {
            "default": "openrouter",
            "type": "string",
            "enum": [
                "anthropic",
                "openrouter"
            ]
        },
        "openrouter": {
            "type": "object",
            "properties": {
                "model": {
                    "type": "string"
                },
                "models": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "model",
                "models"
            ],
            "additionalProperties": false
        },
        "anthropic": {
            "type": "object",
            "properties": {
                "model": {
                    "type": "string"
                },
                "models": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "model",
                "models"
            ],
            "additionalProperties": false
        },
        "summary_length": {
            "default": 72,
            "type": "number",
            "exclusiveMinimum": 0
        },
        "history_count": {
            "default": 10,
            "type": "number",
            "exclusiveMinimum": 0
        },
        "issue_pattern": {
            "type": "string"
        },
        "issue_prefix": {
            "type": "string"
        },
        "use_lazygit": {
            "default": true,
            "type": "boolean"
        },
        "model": {
            "type": "string"
        },
        "models": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "additionalProperties": false
}
